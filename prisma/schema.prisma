generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum SettingsMode {
  MANUAL
  GUIDED
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum WeightUnit {
  KG
  LB
}

enum HeightUnit {
  CM
  IN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalPhase {
  CUT
  MAINTAIN
  BULK
}

enum MacroPreference {
  LOWER
  STANDARD
  HIGHER
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  settings            UserSettings?
  sessions            Session[]
  meals               MealLog[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MealLog {
  id                      String   @id @default(cuid())
  userId                  String?
  mealType                MealType
  description             String
  mealName                String
  photoUrl                String?
  sourceImageName         String?
  estimatedCalories       Int
  proteinG                Float
  carbsG                  Float
  fatG                    Float
  confidenceScore         Float
  confidenceLabel         String
  assumptionsJson         String
  estimatedComponentsJson String
  analysisSource          String   @default("openai")
  analysisModel           String   @default("gpt-4.1")
  consumedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([consumedAt])
  @@index([userId, consumedAt])
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String?  @unique
  targetMode      SettingsMode @default(MANUAL)
  dailyCalories   Int
  proteinTargetG  Float
  carbTargetMinG  Float
  carbTargetMaxG  Float
  fatTargetMinG   Float
  fatTargetMaxG   Float
  goalSex         BiologicalSex?
  ageYears        Int?
  activityLevel   ActivityLevel?
  goalPhase       GoalPhase?
  weightUnit      WeightUnit?
  heightUnit      HeightUnit?
  weightKg        Float?
  heightCm        Float?
  proteinPreference MacroPreference?
  carbPreference    MacroPreference?
  fatPreference     MacroPreference?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
